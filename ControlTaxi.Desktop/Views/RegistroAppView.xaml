<UserControl x:Class="ControlTaxi.Desktop.Views.RegistroAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"><TextBlock Text="REGISTRO APP" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Captura local de viajes de app móvil con catálogos opcionales." Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <WrapPanel DockPanel.Dock="Right"><Button Content="Buscar catálogos" Click="Buscar_Click"/><Button Content="Crear registro" Click="Crear_Click"/></WrapPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Busqueda catálogos" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"/>
                        <UniformGrid Columns="4">
                            <StackPanel><TextBlock Text="Fecha operación"/><DatePicker SelectedDate="{Binding Model.FechaOperacion}"/></StackPanel>
                            <StackPanel><TextBlock Text="Taxista"/><TextBox Text="{Binding Model.TaxistaNombre, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Taxista ID"/><TextBox Text="{Binding Model.TaxistaId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Gafete"/><TextBox Text="{Binding Model.Gafete, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Teléfono"/><TextBox Text="{Binding Model.Telefono, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Nacionalidad"/><TextBox Text="{Binding Model.Nacionalidad, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Placas"/><TextBox Text="{Binding Model.Placas, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Modelo"/><TextBox Text="{Binding Model.Modelo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Unidad"/><TextBox Text="{Binding Model.Unidad, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Hotel"/><TextBox Text="{Binding Model.Hotel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Origen"/><TextBox Text="{Binding Model.Origen, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Sitio"/><TextBox Text="{Binding Model.Sitio, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Destino"/><TextBox Text="{Binding Model.Destino, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Pax"/><TextBox Text="{Binding Model.Pax, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Tipo operación"/><TextBox Text="{Binding Model.TipoOperacion, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Total"/><TextBox Text="{Binding Model.Total, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Método pago"/><TextBox Text="{Binding Model.MetodoPago, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Notas"/><TextBox Text="{Binding Model.Notas, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="Taxistas"/><DataGrid ItemsSource="{Binding Taxistas}" Height="220"/></StackPanel></Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="12,0,0,0"><StackPanel><TextBlock Text="Tarifas"/><DataGrid ItemsSource="{Binding Tarifas}" Height="220"/></StackPanel></Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="12,0,0,0"><StackPanel><TextBlock Text="Hoteles"/><ListBox ItemsSource="{Binding Hoteles}" Height="220"/></StackPanel></Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</UserControl>
