<UserControl x:Class="ControlTaxi.Desktop.Views.RegistroDiarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"><TextBlock Text="REGISTRO DIARIO" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Operaciones del día, filtros, selección y actualización." Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <WrapPanel DockPanel.Dock="Right"><Button Content="Consultar" Click="Consultar_Click"/><Button Content="Guardar" Click="Guardar_Click"/></WrapPanel>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,14,0,14">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <UniformGrid Columns="6">
                    <StackPanel><TextBlock Text="Folio" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding FolioOperacion, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel><TextBlock Text="Fecha inicio" Foreground="{StaticResource MutedBrush}"/><DatePicker SelectedDate="{Binding FechaInicio}"/></StackPanel>
                    <StackPanel><TextBlock Text="Fecha fin" Foreground="{StaticResource MutedBrush}"/><DatePicker SelectedDate="{Binding FechaFin}"/></StackPanel>
                    <StackPanel><TextBlock Text="Fecha trabajo" Foreground="{StaticResource MutedBrush}"/><DatePicker SelectedDate="{Binding FechaTrabajo}"/></StackPanel>
                    <StackPanel><TextBlock Text="Staff" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Staff, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel><TextBlock Text="Pax" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Pax, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                </UniformGrid>
            </Border>
            <UniformGrid Columns="3" Margin="0,12,0,0">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Efectivo"/><TextBlock Text="{Binding TotalEfectivo, StringFormat={}{0:C2}}" FontWeight="Bold"/></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Tarjeta"/><TextBlock Text="{Binding TotalTarjeta, StringFormat={}{0:C2}}" FontWeight="Bold"/></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Total"/><TextBlock Text="{Binding TotalGeneral, StringFormat={}{0:C2}}" FontWeight="Bold"/></StackPanel></Border>
            </UniformGrid>
            <DataGrid ItemsSource="{Binding Operaciones}" SelectedItem="{Binding SelectedOperacion}" Height="520" Margin="0,12,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</UserControl>
