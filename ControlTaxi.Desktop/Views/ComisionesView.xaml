<UserControl x:Class="ControlTaxi.Desktop.Views.ComisionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="COMISIONES" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Consulta, recálculo, pago individual, pago múltiple y abonos parciales." Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Content="Buscar" Command="{Binding ConsultarCommand}" />
                        <Button Content="Calcular" Command="{Binding RecalcularCommand}" />
                        <Button Content="Pagar selección" Command="{Binding PagarSeleccionCommand}" />
                    </WrapPanel>
                </DockPanel>
                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Width="300"><TextBlock Text="Buscar folio / ticket / taxista / hotel / gafete" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding FolioOperacion, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Width="150"><TextBlock Text="De fecha" Foreground="{StaticResource MutedBrush}" /><DatePicker SelectedDate="{Binding FechaInicio}" /></StackPanel>
                    <StackPanel Width="150"><TextBlock Text="A fecha" Foreground="{StaticResource MutedBrush}" /><DatePicker SelectedDate="{Binding FechaFin}" /></StackPanel>
                    <StackPanel Width="140"><TextBlock Text="Abono" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding ImporteAbono, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Abonar parcial" Command="{Binding AbonarCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="7">
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Venta" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding TotalVenta, StringFormat={}{0:C2}}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Base" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding TotalBase, StringFormat={}{0:C2}}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Comisión" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding TotalComision, StringFormat={}{0:C2}}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Pagado" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding TotalPagado, StringFormat={}{0:C2}}" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Pendientes" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Pendientes}" FontSize="20" FontWeight="Bold" /></StackPanel></Border>
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Pagadas" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Pagadas}" FontSize="20" FontWeight="Bold" /></StackPanel></Border>
                    <Border Background="#FFFFF7ED" CornerRadius="12" Padding="12" Margin="4"><StackPanel><TextBlock Text="Seleccionado" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding TotalSeleccionado, StringFormat={}{0:C2}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" /></StackPanel></Border>
                </UniformGrid>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Registros de comisiones" FontSize="18" FontWeight="SemiBold" />
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="Pagar seleccionada" Command="{Binding PagarSeleccionadaCommand}" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Pagar selección" Command="{Binding PagarSeleccionCommand}" />
                            </WrapPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Comisiones}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" Height="560" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Sel" Binding="{Binding IsSelected}" Width="45" />
                                <DataGridTextColumn Header="Folios" Binding="{Binding Folio}" Width="110" />
                                <DataGridTextColumn Header="Unidad" Binding="{Binding Transporte}" Width="90" />
                                <DataGridTextColumn Header="Num unidad" Binding="{Binding NumeroUnidad}" Width="90" />
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Taxista}" Width="160" />
                                <DataGridTextColumn Header="Pax" Binding="{Binding Pax}" Width="55" />
                                <DataGridTextColumn Header="Hotel" Binding="{Binding Hotel}" Width="140" />
                                <DataGridTextColumn Header="V.A" Binding="{Binding VentaArtesania, StringFormat={}{0:C2}}" Width="90" />
                                <DataGridTextColumn Header="V.F" Binding="{Binding VentaFarmacia, StringFormat={}{0:C2}}" Width="90" />
                                <DataGridTextColumn Header="V.T" Binding="{Binding VentaTienda, StringFormat={}{0:C2}}" Width="90" />
                                <DataGridTextColumn Header="V.J" Binding="{Binding VentaJoyeria, StringFormat={}{0:C2}}" Width="90" />
                                <DataGridTextColumn Header="Vnt total" Binding="{Binding Base, StringFormat={}{0:C2}}" Width="95" />
                                <DataGridTextColumn Header="Ticket" Binding="{Binding Ticket}" Width="110" />
                                <DataGridTextColumn Header="F.P" Binding="{Binding FormaPago}" Width="80" />
                                <DataGridTextColumn Header="% descuento" Binding="{Binding DescuentoAplicado}" Width="95" />
                                <DataGridTextColumn Header="Dejada" Binding="{Binding DeduccionDejada, StringFormat={}{0:C2}}" Width="95" />
                                <DataGridTextColumn Header="Bebidas/cajas" Binding="{Binding BebidasCajas, StringFormat={}{0:C2}}" Width="110" />
                                <DataGridTextColumn Header="Rep" Binding="{Binding DeduccionReparacion, StringFormat={}{0:C2}}" Width="85" />
                                <DataGridTextColumn Header="Degustación" Binding="{Binding DeduccionDegustacion, StringFormat={}{0:C2}}" Width="105" />
                                <DataGridTextColumn Header="% comisión" Binding="{Binding Porcentaje}" Width="95" />
                                <DataGridTextColumn Header="Pago comisión" Binding="{Binding Importe, StringFormat={}{0:C2}}" Width="115" />
                                <DataGridTextColumn Header="Pago" Binding="{Binding Pago, StringFormat={}{0:C2}}" Width="90" />
                                <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="95" />
                                <DataGridTextColumn Header="Vendedor" Binding="{Binding Vendedor}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
