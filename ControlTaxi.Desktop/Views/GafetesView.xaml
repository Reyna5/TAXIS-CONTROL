<UserControl x:Class="ControlTaxi.Desktop.Views.GafetesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="LLEGADAS A SUCURSALES / GAFETES" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Alta, edición, búsqueda, regreso individual y regreso masivo de gafetes." Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Consultar" Command="{Binding ConsultarCommand}" />
                    <Button Content="Guardar" Command="{Binding GuardarCommand}" />
                    <Button Content="Nuevo" Command="{Binding NuevoCommand}" Style="{StaticResource SecondaryButton}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding EsEdicion, StringFormat=Modo edición: {0}}" FontWeight="SemiBold" />
                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <StackPanel><TextBlock Text="Matrícula" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Matricula, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Gafete" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Gafete, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Folio operación" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding FolioOperacion, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Movimiento" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Movimiento, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Filtros" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Width="150"><TextBlock Text="De fecha" Foreground="{StaticResource MutedBrush}" /><DatePicker SelectedDate="{Binding FechaInicio}" /></StackPanel>
                                <StackPanel Width="150"><TextBlock Text="A fecha" Foreground="{StaticResource MutedBrush}" /><DatePicker SelectedDate="{Binding FechaFin}" /></StackPanel>
                                <CheckBox Content="Solo sin fecha regreso" IsChecked="{Binding SoloSinFecha}" VerticalAlignment="Center" Margin="8,20,12,0" />
                                <Button Content="Buscar" Command="{Binding ConsultarCommand}" />
                                <Button Content="Buscar gafete activo" Command="{Binding BuscarGafeteCommand}" Style="{StaticResource SecondaryButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding TotalFilas, StringFormat=Relación de gafetes ({0})}" FontSize="18" FontWeight="SemiBold" />
                                <Button Content="Regresar seleccionados" Command="{Binding RegistrarRegresoSeleccionadosCommand}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Filas}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" Height="440" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Sel" Binding="{Binding IsSelected}" Width="45" />
                                    <DataGridTextColumn Header="Gafete" Binding="{Binding Gafete}" Width="90" />
                                    <DataGridTextColumn Header="Staff" Binding="{Binding Staff}" Width="90" />
                                    <DataGridTextColumn Header="Folio Operación" Binding="{Binding FolioOperacion}" Width="120" />
                                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="90" />
                                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110" />
                                    <DataGridTextColumn Header="Nacionalidad" Binding="{Binding Nacionalidad}" Width="120" />
                                    <DataGridTextColumn Header="Entrega" Binding="{Binding Entrega}" Width="140" />
                                    <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" Width="95" />
                                    <DataGridTextColumn Header="Regreso" Binding="{Binding Regreso}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Acciones" FontSize="18" FontWeight="SemiBold" />
                        <Button Content="Guardar / actualizar" Command="{Binding GuardarCommand}" Margin="0,12,0,0" />
                        <Button Content="Registrar regreso" Command="{Binding RegistrarRegresoCommand}" />
                        <Button Content="Nuevo registro" Command="{Binding NuevoCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Regreso de gafetes en bloque" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Escanee o capture varios gafetes separados por coma, espacio, salto de línea o punto y coma." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" />
                        <TextBox Text="{Binding GafetesBloque, UpdateSourceTrigger=PropertyChanged}" MinHeight="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <Button Content="Regresar bloque" Command="{Binding RegistrarRegresoBloqueCommand}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
