<UserControl x:Class="ControlTaxi.Desktop.Views.GastosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="GASTOS" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Consulta y captura de gastos por folio." Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Consultar" Command="{Binding ConsultarCommand}" />
                    <Button Content="Guardar gasto" Command="{Binding GuardarCommand}" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,14,0,14">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <UniformGrid Columns="4">
                        <StackPanel><TextBlock Text="Folio operación" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding FolioOperacion, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Importe" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Importe, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Concepto" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Total día" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Model.TotalDia, StringFormat={}{0:C2}}" FontSize="20" FontWeight="Bold" /></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Observaciones" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Filas}" Height="480" />
            </Border>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
