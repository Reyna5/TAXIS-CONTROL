<UserControl x:Class="ControlTaxi.Desktop.Views.RelacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="RELACION TICKET - TAXISTA" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Vinculacion, pago de dejadas, impresion, reimpresion y descarga de tickets." Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Content="Consultar" Command="{Binding ConsultarCommand}" />
                        <Button Content="Guardar relacion" Command="{Binding GuardarRelacionCommand}" />
                        <Button Content="Pagar dejada" Command="{Binding PagarDejadaCommand}" />
                    </WrapPanel>
                </DockPanel>
                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Width="320">
                        <TextBlock Text="Buscar AP / ticket / taxista / hotel / gafete" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="Fecha inicio" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker SelectedDate="{Binding FechaInicio}" />
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="Fecha fin" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker SelectedDate="{Binding FechaFin}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Formulario de relacion" FontSize="18" FontWeight="SemiBold" />
                                <Button Content="Limpiar" Command="{Binding LimpiarCommand}" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" />
                            </DockPanel>
                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <StackPanel><TextBlock Text="Ticket app otorgado" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding FolioControl, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Folio app movil" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding FolioApp, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Folio operacion asignado" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding FolioOperacion, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Ticket venta POS" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding FolioPos, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Gafete" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Gafete, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Taxista ID" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding TaxistaId, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Nombre taxista" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding TaxistaNombre, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Vendedor" Foreground="{StaticResource MutedBrush}" /><ComboBox ItemsSource="{Binding Vendedores}" Text="{Binding Vendedor, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,4,8,8" /></StackPanel>
                                <StackPanel><TextBlock Text="Nacionalidad" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Nacionalidad, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Transporte" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding TransporteTipo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Dejada" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Dejada, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Comision calculada" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Comision, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Hotel" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Hotel, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Unidad" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Unidad, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Placas" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Placas, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Telefono" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Destino" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Destino, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="Pax" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Pax, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Observaciones" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Viajes recibidos desde App movil / POS" FontSize="18" FontWeight="SemiBold" />
                            <DataGrid ItemsSource="{Binding Relaciones}" SelectedItem="{Binding SelectedRelacion}" Height="430" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="14,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ticket de pago de dejada" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Vista previa térmica 58mm" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10" />
                    <Border Background="#FFFDFDFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" MinHeight="360">
                        <TextBox Text="{Binding TicketPreview}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <Button Content="Imprimir ticket" Command="{Binding ImprimirTicketCommand}" Margin="0,12,0,0" />
                    <Button Content="Reimprimir ticket" Command="{Binding ReimprimirTicketCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Guardar TXT" Command="{Binding GuardarTicketCommand}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
