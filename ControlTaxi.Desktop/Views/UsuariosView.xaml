<UserControl x:Class="ControlTaxi.Desktop.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="USUARIOS Y PERMISOS" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Alta/edición de usuarios, roles, estatus y permisos por módulo." Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Consultar" Command="{Binding ConsultarCommand}" />
                    <Button Content="Guardar usuario" Command="{Binding GuardarCommand}" />
                    <Button Content="Nuevo" Command="{Binding NuevoCommand}" Style="{StaticResource SecondaryButton}" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Usuarios" FontSize="18" FontWeight="SemiBold" />
                    <DataGrid ItemsSource="{Binding Usuarios}" SelectedItem="{Binding SelectedUsuario}" Height="560" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Editor de usuario" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Usuario" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding UsuarioEdicion, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Rol" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Rol, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Estatus" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Estatus, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Permisos" FontSize="18" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Permisos}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Nombre}" Margin="0,4,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Guardar usuario" Command="{Binding GuardarCommand}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
