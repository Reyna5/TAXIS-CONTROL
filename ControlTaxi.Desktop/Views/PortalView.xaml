<UserControl x:Class="ControlTaxi.Desktop.Views.PortalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="PORTAL PLAZA" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Dashboard, operaciones, comisiones, catálogos y captura para Compuamdo/Joyería." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ComboBox ItemsSource="{Binding DatabaseOptions}" SelectedItem="{Binding SelectedDatabase}" Width="185" Margin="0,4,8,8" />
                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" />
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="190" ToolTip="Filtro por folio, vendedor, hotel o producto" />
                    <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FF111827" CornerRadius="14" Padding="14">
                <StackPanel>
                    <TextBlock Text="Secciones Portal" Foreground="White" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                    <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Operaciones" Command="{Binding ShowOperationsCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Comisiones" Command="{Binding ShowCommissionsCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Vendedores" Command="{Binding ShowVendorsCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Productos" Command="{Binding ShowProductsCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Catálogos" Command="{Binding ShowCatalogsCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Nueva operación" Command="{Binding ShowCreateOperationCommand}" />
                    <TextBlock Text="{Binding ActiveSection, StringFormat=Activo: {0}}" Foreground="#FFD1D5DB" TextWrapping="Wrap" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold" />
                            <UniformGrid Columns="6" Margin="0,12,0,0">
                                <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Operaciones" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Metrics.OperationsCount}" FontSize="22" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Tickets" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Metrics.TicketsCount}" FontSize="22" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Artesanías" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Metrics.ArtesaniasTotal, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Joyería" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Metrics.JoyeriaTotal, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Cobrado" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Metrics.PaymentsTotal, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF9FAFB" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Egresos" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Metrics.ExpensesTotal, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="Últimas operaciones" FontWeight="SemiBold" Margin="0,14,0,4" />
                            <DataGrid ItemsSource="{Binding RecentOperations}" Height="170" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Operaciones" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <Button Content="Cargar operaciones" Command="{Binding ShowOperationsCommand}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Operations}" Height="220" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Comisiones" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <Button Content="Cargar comisiones" Command="{Binding ShowCommissionsCommand}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Commissions}" Height="220" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Vendedores" FontSize="20" FontWeight="SemiBold" />
                                    <Button Content="Cargar" Command="{Binding ShowVendorsCommand}" DockPanel.Dock="Right" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Vendors}" Height="220" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="12,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Productos" FontSize="20" FontWeight="SemiBold" />
                                    <Button Content="Cargar" Command="{Binding ShowProductsCommand}" DockPanel.Dock="Right" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Products}" Height="220" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Guías" FontSize="20" FontWeight="SemiBold" />
                                    <Button Content="Cargar catálogos" Command="{Binding ShowCatalogsCommand}" DockPanel.Dock="Right" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Guides}" Height="200" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="12,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Transportes" FontSize="20" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding Transports}" Height="200" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Nueva operación" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <Button Content="Guardar operación" Command="{Binding SaveOperationCommand}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Vendedor" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox ItemsSource="{Binding Vendors}" SelectedValue="{Binding Input.SellerKey, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="VendorKey" DisplayMemberPath="Name" Margin="0,4,8,8" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Cliente / hotel" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.Hotel, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Tipo operación" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.OperationType, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Fecha" Foreground="{StaticResource MutedBrush}" />
                                    <DatePicker SelectedDate="{Binding Input.SaleDate}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Usuario" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Pasajeros" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.PassengerCount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Guía" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox ItemsSource="{Binding Guides}" SelectedValue="{Binding Input.GuideCode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="GuideKey" DisplayMemberPath="Name" Margin="0,4,8,8" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Transportista" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox ItemsSource="{Binding Transports}" SelectedValue="{Binding Input.TransportCode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Code" DisplayMemberPath="Name" Margin="0,4,8,8" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Tipo cambio USD" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.ExchangeRate, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Subtotal" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.Subtotal, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="IVA" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.Tax, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Efectivo" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.Cash, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Tarjeta" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.Card, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Dólares" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Input.Dollars, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Notas" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <TextBox Text="{Binding Input.Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
