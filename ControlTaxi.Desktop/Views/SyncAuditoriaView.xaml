<UserControl x:Class="ControlTaxi.Desktop.Views.SyncAuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="SINCRONIZACION APP / API Y AUDITORIA" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ApiBaseUrl, StringFormat=API: {0}}" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding AutoSyncEnabled, StringFormat=AutoSyncAppMovilFromApi: {0}}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Probar API" Command="{Binding ProbarApiCommand}" />
                    <Button Content="Cargar auditoría" Command="{Binding CargarAuditoriaCommand}" />
                    <Button Content="Ver config local" Command="{Binding AbrirConfiguracionCommand}" Style="{StaticResource SecondaryButton}" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="150"><TextBlock Text="Fecha inicio" Foreground="{StaticResource MutedBrush}" /><DatePicker SelectedDate="{Binding FechaInicio}" /></StackPanel>
                    <StackPanel Width="150"><TextBlock Text="Fecha fin" Foreground="{StaticResource MutedBrush}" /><DatePicker SelectedDate="{Binding FechaFin}" /></StackPanel>
                    <StackPanel Width="260"><TextBlock Text="Filtro auditoría" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding FiltroAuditoria, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </WrapPanel>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Registros App/API" FontSize="18" FontWeight="SemiBold" />
                        <DataGrid ItemsSource="{Binding RegistrosApi}" Height="220" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tarifas API" FontSize="18" FontWeight="SemiBold" />
                            <DataGrid ItemsSource="{Binding TarifasApi}" Height="180" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="12,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Hoteles API" FontSize="18" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding HotelesApi}" Height="180" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Auditoría local" FontSize="18" FontWeight="SemiBold" />
                        <DataGrid ItemsSource="{Binding Auditoria}" Height="360" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
