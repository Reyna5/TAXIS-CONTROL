<UserControl x:Class="ControlTaxi.Desktop.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="CENTRO DE REPORTES" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Operaciones, dejadas, concentrado, cuadre final y pagos de comisiones." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Content="Consultar" Command="{Binding ConsultarCommand}" />
                        <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                </DockPanel>
                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Width="150">
                        <TextBlock Text="Fecha inicio" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker SelectedDate="{Binding FechaInicio}" />
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="Fecha fin" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker SelectedDate="{Binding FechaFin}" />
                    </StackPanel>
                    <StackPanel Width="220">
                        <TextBlock Text="Busqueda" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="210">
                        <TextBlock Text="Tipo reporte" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox SelectedValue="{Binding TipoReporte}" SelectedValuePath="Content" Margin="0,4,8,8">
                            <ComboBoxItem Content="operaciones" />
                            <ComboBoxItem Content="pagos-comisiones" />
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="5">
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="14" Margin="4">
                        <StackPanel>
                            <TextBlock Text="Movimientos" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding TotalMovimientos}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="14" Margin="4">
                        <StackPanel>
                            <TextBlock Text="PAX" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding TotalPax}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="14" Margin="4">
                        <StackPanel>
                            <TextBlock Text="Dejadas" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding TotalDejadas, StringFormat={}{0:C2}}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF9FAFB" CornerRadius="12" Padding="14" Margin="4">
                        <StackPanel>
                            <TextBlock Text="Comision" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding TotalComision, StringFormat={}{0:C2}}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFF7ED" CornerRadius="12" Padding="14" Margin="4">
                        <StackPanel>
                            <TextBlock Text="Pagado" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding TotalPagos, StringFormat={}{0:C2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Exportaciones Excel" FontSize="18" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Reporte taxis" Command="{Binding ExportTaxiExcelCommand}" />
                            <Button Content="Excel dejadas" Command="{Binding ExportDejadasExcelCommand}" />
                            <Button Content="Excel concentrado" Command="{Binding ExportConcentradoExcelCommand}" />
                            <Button Content="Excel cuadre final" Command="{Binding ExportCuadreExcelCommand}" />
                            <Button Content="Excel pagos comisiones" Command="{Binding ExportPagosComisionesExcelCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Operaciones / taxis" FontSize="18" FontWeight="SemiBold" />
                        <DataGrid ItemsSource="{Binding Operaciones}" Height="220" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Control de dejadas" FontSize="18" FontWeight="SemiBold" />
                        <DataGrid ItemsSource="{Binding Dejadas}" Height="260" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Pagos de comisiones" FontSize="18" FontWeight="SemiBold" />
                            <DataGrid ItemsSource="{Binding PagosComisiones}" Height="240" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="12,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Cuadre camiones" FontSize="18" FontWeight="SemiBold" />
                            <DataGrid ItemsSource="{Binding Camiones}" Height="240" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
