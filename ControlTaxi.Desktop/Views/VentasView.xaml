<UserControl x:Class="ControlTaxi.Desktop.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="VENTA" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Punto de venta Desktop con carrito, cobro, remisiones y productos relacionados." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Nuevo" Command="{Binding NuevaVentaCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Cobrar" Command="{Binding CobrarCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Buscar producto / folio / nombre / hotel / gafete" FontWeight="SemiBold" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBox Text="{Binding ProductoBusqueda, UpdateSourceTrigger=PropertyChanged}" MinWidth="360" />
                                <Button Content="Buscar" Command="{Binding BuscarCommand}" Width="110" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Text="Vendedor" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Vendedor, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Cliente" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Usuario" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="App movil / Folio control" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding FolioControl, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Folio App" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding FolioApp, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Gafete" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Gafete, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Transporte" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding TransporteTipo, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Guia mat." Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding GuiaMatricula, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Taxista ID" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding TaxistaId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Taxista" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding TaxistaNombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Producto ID" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding ProductoId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Cantidad" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Pax" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding Pax, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Border Background="#FFF9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Fecha" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding TodayText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Subtotal" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Subtotal, StringFormat={}{0:C2}}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="IVA" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Iva, StringFormat={}{0:C2}}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFFF7ED" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Total" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Total, StringFormat={}{0:C2}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="Tipo de cambio DLS" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding TipoCambio, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Efectivo" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Efectivo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Tarjeta" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Tarjeta, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Dolares" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Dolares, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Ticket actual" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <Button Content="Borrar línea" Command="{Binding BorrarLineaCommand}" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}" Height="180" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Resultados de consulta" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <Button Content="Agregar seleccionado" Command="{Binding AgregarSeleccionadoCommand}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding ResultadosBusqueda}" SelectedItem="{Binding SelectedResultado}" Height="220" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Acciones de venta" FontSize="18" FontWeight="SemiBold" />
                            <Button Content="Cobrar" Command="{Binding CobrarCommand}" Margin="0,12,0,0" />
                            <Button Content="Nuevo ticket" Command="{Binding NuevaVentaCommand}" Style="{StaticResource SecondaryButton}" />
                            <Button Content="Consulta precios" Command="{Binding BuscarCommand}" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Gafetes activos y ventas relacionadas" FontWeight="SemiBold" />
                            <DataGrid ItemsSource="{Binding GafeteVentas}" Height="190" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Detalle de remisión" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Capture un folio de remisión o seleccione una referencia relacionada." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <DockPanel>
                                <TextBox Text="{Binding RemisionFolio, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" />
                                <Button Content="Abrir" Command="{Binding AbrirRemisionCommand}" Width="90" />
                            </DockPanel>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding RemisionDetalle.FolioRegistro, StringFormat=Folio registro: {0}}" />
                                <TextBlock Text="{Binding RemisionDetalle.FolioFactura, StringFormat=Factura: {0}}" />
                                <TextBlock Text="{Binding RemisionDetalle.OrigenVenta, StringFormat=Origen: {0}}" />
                                <TextBlock Text="{Binding RemisionDetalle.Cliente, StringFormat=Cliente: {0}}" />
                                <TextBlock Text="{Binding RemisionDetalle.TaxistaNombre, StringFormat=Taxista: {0}}" />
                                <TextBlock Text="{Binding RemisionDetalle.FolioControl, StringFormat=Folio control: {0}}" />
                                <TextBlock Text="{Binding RemisionDetalle.Total, StringFormat=Total: {0:C2}}" />
                                <TextBlock Text="{Binding RemisionDetalle.TipoCambio, StringFormat=TC: {0}}" />
                            </UniformGrid>
                            <Button Content="Ver productos de remisión" Command="{Binding VerProductosRemisionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" />
                            <DataGrid ItemsSource="{Binding RemisionDetalle.Items}" SelectedItem="{Binding SelectedRemisionItem}" Height="160" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Productos de remisión" FontWeight="SemiBold" />
                            <DataGrid ItemsSource="{Binding RemisionProductos}" Height="190" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</UserControl>
