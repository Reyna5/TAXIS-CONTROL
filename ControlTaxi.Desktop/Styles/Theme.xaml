<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorInk">#1F2937</Color>
    <Color x:Key="ColorMuted">#6B7280</Color>
    <Color x:Key="ColorPanel">#FFFFFFFF</Color>
    <Color x:Key="ColorBackground">#FFF4F6F8</Color>
    <Color x:Key="ColorAccent">#FFB8872D</Color>
    <Color x:Key="ColorAccentDark">#FF7C5A1E</Color>
    <Color x:Key="ColorBorder">#FFE5E7EB</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource ColorAccentDark}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,4,8,8" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Margin" Value="0,4,8,8" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Margin" Value="0,4,8,8" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Margin" Value="0,4,8,8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="#FFF3F4F6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="ColumnHeaderHeight" Value="36" />
    </Style>
</ResourceDictionary>
